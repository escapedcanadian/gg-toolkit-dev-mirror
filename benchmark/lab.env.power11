# IBM Power11 lab — the site this benchmark was developed against.
#
# 3 x Power11 LPAR: 8 dedicated cores, SMT=8 -> 64 logical CPUs, 61.7 GiB, RHEL 9.8 ppc64le.
# 1 x x86_64 KVM guest for monitoring (deliberately NOT part of the measurement: different
# architecture, so it can host Prometheus and Kafka without being a variable).

LAB_SERVERS="129.40.56.124 129.40.56.120"          # vm01, vm02
LAB_CLIENTS="129.40.56.115 129.40.56.124 129.40.56.120"   # vm03 + co-located on the servers
LAB_MONITOR="129.40.56.113"                         # vm04 — x86_64, monitoring only
LAB_ALL_HOSTS="129.40.56.115 129.40.56.124 129.40.56.120 129.40.56.113"

LAB_SSH="ssh -i $HOME/.ssh/gridgain_demo -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=15"

LAB_CLUSTER="power-demo"
# Two elements: vm03's own generator plus one co-located on each server machine. Two elements means
# two run groups, which the harness unions -- see the note in README on why it is not one element.
LAB_ELEMENTS="power-gen-load power-lab-load"
LAB_SCENARIO="power-max-write"
LAB_CACHE="customer"
LAB_CONFIG="src/main/resources/demo-config-power.yaml"
LAB_PROJECT="$HOME/Code/DemoGradleProject/gridgain-demo-toolkit-dev"

LAB_PROM="http://129.40.56.113:9090"
LAB_KAFKA="129.40.56.113:9092"
LAB_METRICS_TOPIC="datagen-metrics"
LAB_CLIENT_PORT=10800

# Version-pinned rather than `current`: this lab's install has the version in the path.
LAB_CONTROL="/opt/gridgain-demo/power-demo/dist/8.9.33/bin/control.sh"
LAB_CONTROL_PORT=11211
LAB_JAVA_HOME="/opt/gridgain-demo/jdk/current"
LAB_KAFKA_CONSUMER="/opt/gridgain-demo/payments-bus/dist/current/bin/kafka-console-consumer.sh"

LAB_RUNS=3
LAB_WARMUP=300
LAB_WINDOW=3m
LAB_LITTLE_TOLERANCE=25
LAB_REGION_LIMIT=80
