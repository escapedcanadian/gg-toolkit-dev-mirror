# Site definition for the GridGain throughput/latency benchmark.
#
# Copy to lab.env.<name> and edit. Everything the harness knows about a particular lab lives here;
# no script contains a machine address, an element name or a path. `run.sh` sources one of these.
#
# ---------------------------------------------------------------------------------------------
# Machines
# ---------------------------------------------------------------------------------------------

# Every machine running a GridGain server node. Space separated.
LAB_SERVERS="10.0.0.1 10.0.0.2"

# Every machine running load generator processes. May overlap LAB_SERVERS (co-located load) or not.
# The first one is used for the TCP round-trip probe, so make it a machine that talks to the cluster.
LAB_CLIENTS="10.0.0.3"

# The monitoring machine: Prometheus, and the Kafka broker the generator publishes metrics to.
LAB_MONITOR="10.0.0.4"

# Every machine the quiet-estate check inspects. Must include anything that could possibly be
# running a generator -- a leaked run on a machine not listed here is invisible and will silently
# inflate every measurement.
LAB_ALL_HOSTS="$LAB_SERVERS $LAB_CLIENTS $LAB_MONITOR"

# How to reach them. Key-based, non-interactive.
LAB_SSH="ssh -i $HOME/.ssh/id_rsa -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=15"

# ---------------------------------------------------------------------------------------------
# Demo elements
# ---------------------------------------------------------------------------------------------

# The cluster element name in demo-config.yaml.
LAB_CLUSTER="my-cluster"

# Generator elements to start for one measurement. Each is a separate `dataGenerate`, so each has
# its own run id and run group; the harness unions their metrics. Order is not significant.
LAB_ELEMENTS="my-load"

# The scenario name inside ops.yaml, and the cache the data model creates.
LAB_SCENARIO="max-write"
LAB_CACHE="customer"

# Path to demo-config.yaml, relative to the toolkit-dev project root.
LAB_CONFIG="src/main/resources/demo-config.yaml"

# Project root -- where ./gradlew lives.
LAB_PROJECT="$HOME/Code/DemoGradleProject/gridgain-demo-toolkit-dev"

# ---------------------------------------------------------------------------------------------
# Ports and paths on the machines
# ---------------------------------------------------------------------------------------------

LAB_PROM="http://$LAB_MONITOR:9090"
LAB_KAFKA="$LAB_MONITOR:9092"
LAB_METRICS_TOPIC="datagen-metrics"

# Thin-client port, used for the RTT probe's socket filter.
LAB_CLIENT_PORT=10800

# control.sh, for resetting the dataset between points. Version-pinned by the install layout, so it
# changes when the GridGain distribution version does.
LAB_CONTROL="/opt/gridgain-demo/$LAB_CLUSTER/dist/current/bin/control.sh"
LAB_CONTROL_PORT=11211
LAB_JAVA_HOME="/opt/gridgain-demo/jdk/current"

# Kafka console consumer, for decoding latency percentiles off the metrics topic.
LAB_KAFKA_CONSUMER="/opt/gridgain-demo/payments-bus/dist/current/bin/kafka-console-consumer.sh"

# ---------------------------------------------------------------------------------------------
# Protocol
# ---------------------------------------------------------------------------------------------

# Runs per data point. The median is reported; fewer than 3 gives no median worth the name.
LAB_RUNS=3
# Seconds to let a run settle before sampling. The sample window ends here.
LAB_WARMUP=300
# Prometheus range for the sample, ending at LAB_WARMUP. Must be shorter than LAB_WARMUP.
LAB_WINDOW=3m
# Discard a run whose in-flight/latency disagrees with measured throughput by more than this (%).
LAB_LITTLE_TOLERANCE=25
# Discard a run that ended with the data region above this % full (persistence off = a hard wall).
LAB_REGION_LIMIT=80
