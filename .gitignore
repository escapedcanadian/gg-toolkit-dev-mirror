**/.DS_Store
.settings/
.project
.classpath
.pydevproject

# Maven
target/

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# GridGain Plugin Runtime Data
.gridgain-runtime/

# Demo Configuration (user-specific, contains credentials)
environment-config.yaml
# Every demo configuration, by pattern rather than by name.
#
# These were listed individually, so the wizard writing `demo-config-hosts-gg8.yaml` produced a
# file git offered to commit — and a demoConfigFile carries licence paths, identity-file paths and
# sometimes credentials outright. Nothing under this pattern is tracked, so widening it removes a
# class of accident rather than changing what is in the repository.
demo-config*.yaml
# Any licence, in either form the vendor issues it. GridGain 9 licences are JSON;
# GridGain 8 and Control Center licences are XML, which earlier rules did not cover at all.
#
# Matched on the word anywhere in the name, not as a `-license` suffix. The suffix form missed
# `gridgain-license-gg8-unlimited.xml` — a real, signed Ultimate licence that sat untracked-but-
# offerable for three days. Naming a licence for what it unlocks is the obvious thing to do, so the
# pattern has to survive it. Both spellings, because the vendor uses one and we write the other.
**/*license*.json
**/*license*.xml
**/*licence*.json
**/*licence*.xml



# IDE
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

ignite/
bin/
work/
**/*.parquet
src/main/python/.ipynb*
src/main/python/__pycache__*
docker-arm/docker/db/*
docker-arm/docker/cli/*
jdbc/*
failure_tests.md

# --- Secrets -------------------------------------------------------------------
#
# `.sops.` in a filename means encrypted. That is what makes this work: the encrypted and plaintext
# forms have DIFFERENT names, so a path rule can tell them apart. The directory sits beside the demo
# config because that is what the toolkit resolves `source.file` against. Deny everything there, then
# allow back only the two forms that are safe to commit.
#
#   src/main/resources/secrets/demo-secrets.yaml         plaintext  -> ignored
#   src/main/resources/secrets/demo-secrets.sops.yaml    encrypted  -> committed
#   src/main/resources/secrets/demo-secrets.yaml.example placeholders -> committed
src/main/resources/secrets/*
!src/main/resources/secrets/*.sops.yaml
!src/main/resources/secrets/*.yaml.example
!src/main/resources/secrets/.gitkeep

# Runtime scratch the toolkit writes under `demo.working_directory`, which the shipped configs set to
# `.` — so these land at the repo root. Root-anchored so they cannot match the source directory above.
#
# /secrets/ is the important one: DeploySecretsAction stages DECRYPTED Kubernetes Secret manifests
# there, one per secret. It used to be covered by accident, back when the encrypted source directory
# was also at the root and its `secrets/*` deny rule caught these too. Moving the source beside the
# demo config took that protection away, so it is stated explicitly here.
/secrets/
/ssh/
/image-artifacts/

# SOPS private keys never belong in the repo. The PUBLIC key in .sops.yaml is fine and is meant to be
# committed.
*.agekey
keys.txt

# Backups and snapshots of a demo config are still a demo config: they carry the same credentials the
# original does. The rule above names the files by their exact names, which a *.backup or a dated
# snapshot slips past — and `git add -A` then sweeps one in. Added after exactly that happened.
demo-config*.backup
demo-config*.bak
demo-config*-backup*

# The generator's own config backups, written by the ops/data migration runner — one per step, so a
# single 7 -> 9 migration leaves four. They are not secret the way a demo config is, they are just
# noise that outlives the migration it guarded. Delete them once the new version has run.
**/*.yaml.*.backup

# Rendered reports. `power-lab-report.md` is the source and is tracked; the PDF is what pandoc makes
# of it, and a 250 KB binary that no diff can read does not belong beside its own source.
*-report.pdf

# Claude Code's accumulated tool-permission allowlists. These are per-machine session state — they
# grow one entry per approved command and are full of absolute paths from whoever ran them — not
# project configuration anyone else can use. Named individually rather than ignoring `.claude/`
# wholesale, so a skill added under `.claude/skills/` is still trackable the way the plugin's and the
# generator's are.
.claude/settings.json
.claude/settings.local.json

# Cleanup safety nets, written by hand before a schema migration or a state change.
# Timestamped so several can coexist; delete them once the change they guard is proven.
# demo-config-*.yaml is ignored above, so a backup of one is the only copy that exists.
config-backup-*/
deployment-archive-*/
