# Template for your secrets. Copy, edit, encrypt. Or run ./scripts/bootstrap-secrets.sh and skip to
# "editing values" below.
#
# ===================================================================================================
# THE NAMING IS THE SAFETY MECHANISM. `.sops.` IN A FILENAME MEANS ENCRYPTED, ALWAYS.
# ===================================================================================================
#
#   secrets/demo-secrets.yaml.example   plaintext placeholders   COMMITTED   (this file)
#   secrets/demo-secrets.yaml           plaintext, yours         GITIGNORED
#   secrets/demo-secrets.sops.yaml      encrypted                COMMITTED
#
# Because the encrypted and plaintext forms have different names, .gitignore can and does protect you:
# `secrets/*` is denied and only `*.sops.yaml` and `*.yaml.example` are allowed back. A plaintext
# secrets file cannot be committed by accident, even by `git add -A`.
#
# There is also a separate file called `.sops.yaml` at the repo root. That one is SOPS's *configuration*
# — it names the public key to encrypt to. It is not a secrets file. Yes, the names are unfortunate;
# they are SOPS's convention, not ours.
#
# ===================================================================================================
# SETUP — one command
# ===================================================================================================
#
#     brew install sops age            # once per laptop
#     ./scripts/bootstrap-secrets.sh   # once per repo; idempotent
#
# That creates an age key if you have none, writes `.sops.yaml` with your public key, and creates
# `secrets/demo-secrets.sops.yaml` by encrypting this example **directly**. The real file is therefore
# born encrypted: at no point does a plaintext copy of it exist on disk. That matters — the plaintext
# window is where credentials get left behind.
#
# ===================================================================================================
# EDITING VALUES
# ===================================================================================================
#
# Preferred, because no plaintext ever touches the disk:
#
#     sops secrets/demo-secrets.sops.yaml      # opens $EDITOR, re-encrypts on save
#
# For bulk editing, if you would rather work in a plain file:
#
#     sops --decrypt secrets/demo-secrets.sops.yaml > secrets/demo-secrets.yaml   # gitignored
#     $EDITOR secrets/demo-secrets.yaml
#     ./scripts/encrypt-secrets.sh             # writes the .sops.yaml form, removes the plaintext
#
# Check state at any time:
#
#     grep -q '^sops:' secrets/demo-secrets.sops.yaml && echo ENCRYPTED || echo PLAINTEXT
#
# An example file having no `sops:` block is correct — the block appears only after encryption.
#
# ===================================================================================================
# VALUES
# ===================================================================================================
#
postgres-mainframe-proxy-auth:
  username: payments
  password: payments-pw-replace-me

mariadb-analytics-auth:
  username: payments
  password: payments-pw-replace-me
  root_password: root-pw-replace-me

mainframe-to-gg-debezium-auth:
  # Username/password must match the role the Postgres init script creates
  # (see 10-replication-user.sql).
  username: debezium
  password: debezium-password-replace-me

gg-to-postgres-jdbc-auth:
  # Credentials the GG→Postgres write-through JDBC sink connector uses.
  # Must match postgres-mainframe-proxy-auth (same DB, same user).
  username: payments
  password: payments-pw-replace-me

gg-to-mariadb-jdbc-auth:
  # Credentials the GG→MariaDB write-through JDBC sink connector uses.
  # Must match mariadb-analytics-auth (same DB, same user).
  username: payments
  password: payments-pw-replace-me
